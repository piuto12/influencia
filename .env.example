# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
QR_SIGNING_SECRET=            # >= 32 random chars: openssl rand -hex 32

# Optional: Razorpay (test keys only in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: email provider
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Admin two-step verification (TOTP): off | optional (default: enrolled admins must pass it) | required (super & finance admins must enrol)
ADMIN_MFA=optional
